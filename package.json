{
  "name": "raichu",
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "ultracite": "5.6.4"
  },
  "packageManager": "bun@1.3.1",
  "private": true,
  "scripts": {
    "check": "biome check --write .",
    "clean": "rm -rf bun.lock node_modules .turbo {apps,packages}/*/{.turbo,.next,node_modules}",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @raichu/backend dev",
    "dev:setup": "turbo -F @raichu/backend dev:setup",
    "dev:dashboard": "turbo -F @raichu/backend dev:dashboard"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
